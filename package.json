{
  "name": "snake-worms",
  "description": "SNAKES: turn-based snake artillery. Sheep rain, holy eggs, a CPU that trolls you, and a Live Clanker Arena where two frontier AIs play it. Plays in your browser.",
  "license": "MIT",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "export": "npm run build && node scripts/export.mjs",
    "test": "node tests/weapons.ts && node tests/sim.ts 6",
    "arena": "vite --mode arena",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.host.json",
    "test:arena": "node tests/arena.ts"
  },
  "devDependencies": {
    "@github/copilot-sdk": "^1.0.19",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
